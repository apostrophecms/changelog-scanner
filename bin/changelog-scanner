#!/usr/bin/env node

const qs = require('qs');
const argv = require('boring')();
const fs = require('fs');
const results = {};
let team = [];
let allRepos = [];

// NEW: flag to only print repo names that have changes
const namesOnly = !!argv.names; // use: --names

const since = argv.since;
const sort = argv.sort || 'created';

const orgs = argv._;
if (orgs.length < 1) {
  usage();
}
if (!since || typeof since !== 'string') {
  usage();
}
const token = process.env.GITHUB_ACCESS_TOKEN;
if (!token) {
  usage();
}

go();

async function go() {
  try {
    for (const org of orgs) {
      if (!namesOnly) console.log('⏳ Collecting repos for', org);
      let page = 1;
      while (true) {
        const params = {
          page,
          sort,
          per_page: 100 // fewer requests
        };
        const url = `https://api.github.com/orgs/${org}/repos?${qs.stringify(params)}`;

        const repos = await get(url);

        if (!Array.isArray(repos)) {
          if (!namesOnly) console.error('Error retrieving repos:', repos);
          return;
        }

        allRepos = allRepos.concat(repos.map(repo => `${org}/${repo.name}`));
        if (!repos.length) {
          break;
        }
        if (!namesOnly) console.log(`⏳ ${repos.length} repos found. Checking for more...`);
        page++;
      }

      if (!namesOnly) console.log(`⏳ Found ${allRepos.length} repos for ${org}`);
    }

    for (const repo of allRepos) {
      if (!namesOnly) console.log(`⏳ Checking commits for ${repo}`);
      let page = 1;
      let allCommits = [];
      while (true) {
        const params = {
          page,
          since,
          per_page: 100
        };
        const url = `https://api.github.com/repos/${repo}/commits?${qs.stringify(params)}`;
        const commits = await get(url);
        if (!Array.isArray(commits)) break;
        allCommits = allCommits.concat(commits);
        if (!commits.length || commits.length < 100) {
          break;
        }
        page++;
      }

      if (allCommits.length) {
        if (namesOnly) {
          // ONLY the repo name, one per line
          console.log(repo);
        } else {
          console.log(`💁🏼‍♀️ ${repo} ***`);
          for (const commit of allCommits) {
            console.log(commit.commit.message);
            console.log(commit.commit.committer.name);
            console.log(commit.commit.committer.email);
            console.log(commit.commit.committer.date);
            console.log();
          }
        }
      }
    }
  } catch (e) {
    if (!namesOnly) console.error(e);
    process.exit(1);
  }
}

async function get(url) {
  const response = await fetch(url, {
    headers: {
      'User-Agent': 'changelog-scanner',
      'Authorization': `token ${token}`
    }
  });
  // 409 means empty repo (e.g. security advisory repos with no commits) — treat as no results
  if (response.status === 409) {
    return [];
  }
  if (response.status >= 400) {
    throw response;
  }
  const result = await response.json();
  return result;
}

function usage() {
  console.error('Usage: changelog-scanner org1 org2 org3... --since=YYYY-MM-DD [--names]');
  console.error('You must also make sure GITHUB_ACCESS_TOKEN is set in your environment.');
  process.exit(1);
}
